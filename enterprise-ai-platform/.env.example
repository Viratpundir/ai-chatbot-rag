# =============================================================
# Enterprise AI Knowledge Platform — Environment Variables
# =============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# All secrets must be changed before deploying to production.

# -------------------------------------------------------------
# Application
# -------------------------------------------------------------
APP_NAME=Enterprise AI Knowledge Platform
APP_VERSION=1.0.0
APP_ENV=development           # development | staging | production
DEBUG=true

# -------------------------------------------------------------
# Security
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
# -------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_generate_a_64_byte_hex_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -------------------------------------------------------------
# Database (PostgreSQL)
# -------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/enterprise_ai
DATABASE_ECHO=false

# -------------------------------------------------------------
# Redis
# -------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_ENABLED=false
FAISS_SINGLE_INSTANCE=false

# -------------------------------------------------------------
# Email (SMTP)
# -------------------------------------------------------------
EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_USERNAME=your-smtp-username
EMAIL_PASSWORD=your-smtp-password
EMAIL_FROM=noreply@yourcompany.com
EMAIL_FROM_NAME=Enterprise AI Platform
EMAIL_USE_TLS=true

# -------------------------------------------------------------
# OTP settings
# -------------------------------------------------------------
OTP_EXPIRE_SECONDS=300          # 5 minutes
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60  # 1 minute between resends

# -------------------------------------------------------------
# Email domain restrictions
# Leave empty to allow all domains.
# Example: ALLOWED_EMAIL_DOMAINS=company.com,university.edu
# -------------------------------------------------------------
ALLOWED_EMAIL_DOMAINS=

# -------------------------------------------------------------
# Password policy
# -------------------------------------------------------------
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30

# -------------------------------------------------------------
# LLM — Ollama (local, recommended for production privacy)
# -------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
LLM_TEMPERATURE=0.2

# OpenAI fallback (optional — leave empty to use Ollama only)
OPENAI_API_KEY=

# -------------------------------------------------------------
# Embeddings
# -------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# -------------------------------------------------------------
# Vector store (FAISS persistence path)
# -------------------------------------------------------------
VECTOR_STORE_PATH=./data/vector_store

# -------------------------------------------------------------
# Document storage
# -------------------------------------------------------------
UPLOAD_DIR=./data/uploads
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_DOCUMENT_PREFIX=documents
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=["pdf","docx","txt","md","html"]

# -------------------------------------------------------------
# RAG pipeline
# -------------------------------------------------------------
RETRIEVAL_TOP_K=5
RERANKER_TOP_N=3
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
DAILY_CHAT_LIMIT=50          # Questions allowed per user per UTC day

# -------------------------------------------------------------
# CORS — space-separated or JSON list of allowed origins
# In production, set to your actual frontend URL(s).
# -------------------------------------------------------------
CORS_ORIGINS=["http://localhost:8501","http://localhost:3000","http://127.0.0.1:3000"]

# Optional local admin seeding; never commit real values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Platform Administrator
ADMIN_PROMOTE_EXISTING=false

# -------------------------------------------------------------
# Production backend overrides (configure in the backend host)
# -------------------------------------------------------------
# APP_ENV=production
# DEBUG=false
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/enterprise_ai
# JWT_SECRET_KEY=replace_with_a_long_stable_random_secret
# CELERY_ENABLED=true
# FAISS_SINGLE_INSTANCE=false
# REDIS_URL=rediss://USER:PASSWORD@REDIS_HOST:6379/0
# VECTOR_STORE_PATH=/mnt/efs/nexaiq/vector_store
# S3_BUCKET=your-private-document-bucket
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=                 # Prefer the host's IAM/task role when supported.
# S3_SECRET_ACCESS_KEY=
# OLLAMA_HOST=https://your-reachable-ollama-service
# OPENAI_API_KEY=                   # Optional fallback; use only if configured.
# CORS_ORIGINS=["https://your-frontend.vercel.app"]

# For the Render Blueprint's single-instance disk-backed API deployment instead:
# CELERY_ENABLED=false
# FAISS_SINGLE_INSTANCE=true
# VECTOR_STORE_PATH=/var/data/vector_store
